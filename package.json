{
  "name": "tanstack-playground",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "lint": "oxlint src/ vite.config.ts",
    "ci": "biome check . && oxlint src/ vite.config.ts",
    "lint:fix": "oxlint src/ vite.config.ts --fix",
    "typecheck": "tsgo --project tsconfig.json --noEmit",
    "prepare": "lefthook install",
    "preview": "pnpm run build && wrangler dev",
    "test": "vitest run",
    "deploy": "pnpm run build && wrangler deploy"
  },
  "dependencies": {
    "@hookform/resolvers": "5.4.0",
    "@mantine/core": "8.3.18",
    "@mantine/hooks": "8.3.18",
    "@mantine/notifications": "8.3.18",
    "@tabler/icons-react": "3.41.1",
    "@tanstack/react-devtools": "0.10.5",
    "@tanstack/react-query": "5.101.0",
    "@tanstack/react-query-devtools": "5.101.0",
    "@tanstack/react-router": "1.170.15",
    "@tanstack/react-router-devtools": "1.167.0",
    "lucide-react": "0.545.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "7.75.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@tanstack/devtools-vite": "0.3.12",
    "@tanstack/router-plugin": "1.168.18",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "25.9.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@typescript/native-preview": "7.0.0-dev.20260613.1",
    "@vitejs/plugin-react": "6.0.2",
    "jsdom": "27.4.0",
    "lefthook": "1.13.6",
    "msw": "2.14.6",
    "oxlint": "1.69.0",
    "typescript": "5.9.3",
    "vite": "8.0.16",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "3.2.6",
    "wrangler": "4.87.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
